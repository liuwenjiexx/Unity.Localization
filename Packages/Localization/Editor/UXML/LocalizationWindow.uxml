<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/unity.localization/Editor/USS/LocalizationWindow.uss?fileID=7433441132597879392&amp;guid=23fb29d4e8c67e740a45417c270ebedd&amp;type=3#LocalizationWindow"/>
    <ui:VisualElement style="flex-grow: 0; flex-shrink: 0;">
        <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
            <ui:DropdownField label="" name="selected_lang"/>
            <ui:Label text="Label" name="lang_status"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement style="flex-grow: 0; flex-shrink: 0;">
        <uie:Toolbar name="Toolbar">
            <ui:TextField label="" placeholder-text="New Key" name="new_key" style="flex-grow: 1;"/>
            <uie:ToolbarMenu name="new_value_type"/>
            <uie:ToolbarButton text="New File" name="new-file"/>
            <uie:ToolbarButton text="↻" name="refresh"/>
            <uie:ToolbarSpacer style="flex-grow: 1;"/>
            <uie:ToolbarPopupSearchField name="search"/>
        </uie:Toolbar>
    </ui:VisualElement>
    <ui:VisualElement name="list" class="list" style="flex-grow: 1;">
        <ui:VisualElement name="list-header-container" class="list-header-container">
            <ui:VisualElement class="list-header list-header-key">
                <ui:Label text="Key"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ListView name="" show-alternating-row-backgrounds="ContentOnly"/>
    </ui:VisualElement>
    <ui:VisualElement name="status-bar" class="status-bar" style="height: 18px; justify-content: center; padding-left: 5px; flex-shrink: 0;">
        <ui:Label text="Label" name="status"/>
    </ui:VisualElement>
</ui:UXML>
